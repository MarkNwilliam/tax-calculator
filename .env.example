# Copy to .env and fill in. .env is gitignored - never commit real keys.
IBMCLOUD_API_KEY=your-ibm-cloud-api-key
IBMCR_REGION=us-south
IBMCR_NAMESPACE=tax-calculator
IMAGE_NAME=tax-calculator
IMAGE_TAG=1.0.0

# For DEPLOY_TARGET=codeengine
DEPLOY_TARGET=codeengine
CE_PROJECT=tax-calculator-project

# For DEPLOY_TARGET=kubernetes
IKS_CLUSTER=my-cluster
